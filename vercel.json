{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node -e \"require('fs').mkdirSync('vercel-public',{recursive:true});require('fs').writeFileSync('vercel-public/.vercel-keep','')\"",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/**,frontend/**,css/**,js/**,index.html}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "fra1"
  ]
}
